{
  "name": "sugarcommerce/settings",
  "description": "A plugin's settings page from a list of fields, with its tabs, cards, saving, refusing and export, and one reader for its settings that works before the page exists.",
  "homepage": "https://github.com/SugarCommerce/settings",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/fields": "dev-main"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "suggest": {
    "sugarcommerce/emails": "Sends the emails an email_editor field edits: Options::email() is the shape its settings callable reads."
  },
  "repositories": [
    {
      "type": "path",
      "url": "../fields",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../geo",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../security",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../dates",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../text",
      "options": {
        "symlink": false
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Settings\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Settings\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/stubs.php",
      "/tests/kit/"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "docs:verify": "php vendor/sugarcommerce/fields/bin/verify-docs.php --calls=Page::register --keys=tab,section README.md"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/SugarCommerce/settings/issues",
    "source": "https://github.com/SugarCommerce/settings"
  },
  "keywords": [
    "wordpress",
    "settings",
    "options",
    "admin",
    "tabs",
    "encryption"
  ]
}
